# Local Express backend. Frontend runs on port 3001.
# On Vercel, set this to your deployed backend HTTPS URL BEFORE building.
# NEXT_PUBLIC values are public: never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000


# Optional server-only override for authentication requests:
# API_BASE_URL=http://localhost:3000

# Server-only. Match the backend BEARER_KEY exactly, including any trailing spaces.
# Example only; use your backend value locally and in Vercel environment settings.
BEARER_KEY="Bearer "
